{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node",
      "vite/client",
      "vitest/globals"
    ],
    "paths": {
      "@variocube/cube-app-sdk": [
        "./packages/cube-app-sdk/src/index.ts"
      ],
      "@variocube/cube-app-react-sdk": [
        "./packages/cube-app-react-sdk/src/index.tsx"
      ],
      "@sdk/session": [
        "./packages/cube-app-sdk/src/session.ts"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/test/**/*.ts",
    "packages/*/test/**/*.tsx",
    "packages/cube-app-demo/**/*.tsx",
    "test/**/*.ts",
    "vitest*.ts"
  ]
}
